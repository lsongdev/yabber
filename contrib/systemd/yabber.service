[Unit]
Description=yabber HTTP/HTTPS gateway
Documentation=https://github.com/lsongdev/yabber
Wants=network-online.target
After=network-online.target

# Configuration (/var/lib/yabber/config.yaml) and data (ACME, pid, API token)
# share the state directory, so the management API can save changes while
# /etc stays read-only to the service.
# Reload: systemctl reload yabber
# Upgrade: yabber update && systemctl restart yabber

[Service]
Type=simple
User=yabber
Group=yabber
StateDirectory=yabber
StateDirectoryMode=0700
ExecStartPre=/usr/local/bin/yabber check -d /var/lib/yabber
ExecStart=/usr/local/bin/yabber run -d /var/lib/yabber -admin 127.0.0.1:9180
ExecReload=/usr/local/bin/yabber check -d /var/lib/yabber
ExecReload=/usr/local/bin/yabber reload -d /var/lib/yabber
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/yabber
UMask=0077

[Install]
WantedBy=multi-user.target
